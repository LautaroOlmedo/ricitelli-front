---
import AppLayout from "@/layouts/AppLayout.astro";
import AdminNav from "@/components/admin/AdminNav.astro";
import MetricCard from "@/components/admin/MetricCard.astro";
import { COOKIE_NAME } from "@/lib/auth";
import { getMonthlyVATPosition } from "@/lib/grpc/purchasingAdministrationClient";
const month=Astro.url.searchParams.get("month")??new Date().toISOString().slice(0,7);let position:any=null,error="";
try{position=await getMonthlyVATPosition(month,Astro.cookies.get(COOKIE_NAME)?.value)}catch(e:any){error=e.message}
---
<AppLayout title="IVA del período"><AdminNav/><div class="mx-auto max-w-6xl space-y-6 px-4 py-7 sm:px-8"><div><p class="text-xs font-semibold uppercase tracking-[.2em] text-primary">Impuestos</p><h1 class="mt-2 text-3xl font-display">IVA del período</h1><p class="mt-1 text-sm text-muted-foreground">Resumen del débito fiscal de ventas y el crédito fiscal de compras.</p></div><form method="GET" class="flex flex-wrap gap-2 rounded-2xl border border-border bg-card p-4"><input type="month" name="month" value={month} class="rounded-lg border border-input bg-background px-3 py-2 text-sm"/><button class="rounded-lg bg-primary px-4 py-2 text-sm font-semibold text-primary-foreground">Consultar período</button></form>{error&&<div class="rounded-lg border border-destructive/30 bg-destructive/5 p-4 text-sm text-destructive">{error}</div>}{position&&<><div class="grid gap-4 sm:grid-cols-3"><MetricCard label="IVA débito ventas" value={`ARS ${position.sales_debit_total}`} detail="Generado por facturas de venta" href="#detalle"/><MetricCard label="IVA crédito compras" value={`ARS ${position.purchase_credit_total}`} detail="Generado por facturas de proveedor" href="#detalle"/><MetricCard label="Saldo neto del período" value={`ARS ${position.net_vat}`} detail={Number(position.net_vat)>=0?"Saldo a ingresar":"Saldo a favor"} href="#detalle" tone="alert"/></div><div id="detalle" class="overflow-hidden rounded-2xl border border-border bg-card"><div class="border-b border-border p-4"><h2 class="font-semibold">Desglose por alícuota</h2></div>{position.lines?.length?<table class="w-full text-sm"><thead class="bg-muted/40"><tr><th class="p-3 text-left">Alícuota</th><th class="p-3 text-right">Débito ventas</th><th class="p-3 text-right">Crédito compras</th><th class="p-3 text-right">IVA neto</th></tr></thead><tbody class="divide-y divide-border">{position.lines.map((line:any)=><tr><td class="p-3 font-medium">{line.tax_rate}%</td><td class="p-3 text-right">{line.sales_debit}</td><td class="p-3 text-right">{line.purchase_credit}</td><td class="p-3 text-right font-semibold">{line.net_vat}</td></tr>)}</tbody></table>:<div class="p-10 text-center text-sm text-muted-foreground">No hay movimientos de IVA para este período.</div>}</div></>}</div></AppLayout>
