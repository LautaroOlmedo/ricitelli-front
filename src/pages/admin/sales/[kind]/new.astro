---
import AppLayout from "@/layouts/AppLayout.astro";
import AdminNav from "@/components/admin/AdminNav.astro";
import { COOKIE_NAME } from "@/lib/auth";
import { getCustomers } from "@/lib/grpc/customerClient";
import { getSaleOrders } from "@/lib/grpc/saleOrderClient";
import { getProducts } from "@/lib/grpc/productClient";
import { listSalesInvoices, getSalesInvoiceOutstandingBalance } from "@/lib/grpc/salesAdministrationClient";
import type { SalesDocumentKind } from "@/lib/grpc/salesAdministrationTypes";
const config={invoices:{title:"Nueva factura de venta",help:"Seleccioná un pedido y revisá los ítems antes de guardar el borrador."},remittances:{title:"Nuevo remito",help:"Prepará una entrega parcial o total. El stock se descuenta recién al confirmar."},receipts:{title:"Registrar cobranza",help:"Aplicá el pago a una factura pendiente y verificá el saldo."}} as const;
const kind=Astro.params.kind as SalesDocumentKind;if(!config[kind])return Astro.redirect("/admin");
const token=Astro.cookies.get(COOKIE_NAME)?.value;
const [customers,orders,products,invoices]=await Promise.all([getCustomers(token).catch(()=>[]),getSaleOrders(token).catch(()=>[]),getProducts(token).catch(()=>[]),listSalesInvoices({status:"ISSUED"},token).catch(()=>[])]);
const balances=Object.fromEntries(await Promise.all(invoices.map(async i=>{try{return[i.id,(await getSalesInvoiceOutstandingBalance(i.id,token)).outstanding_balance]}catch{return[i.id,"0"]}})));
const selectedInvoice=Astro.url.searchParams.get("invoice")??"";
const input="w-full rounded-lg border border-input bg-background px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-ring";
const today=new Date().toISOString().slice(0,10);
---
<AppLayout title={config[kind].title}><AdminNav/><div class="mx-auto max-w-6xl space-y-6 px-4 py-7 sm:px-8">
<header><a href={`/admin/sales/${kind}`} class="text-xs font-semibold text-primary">← Volver al listado</a><h1 class="mt-3 text-3xl font-display">{config[kind].title}</h1><p class="mt-1 text-sm text-muted-foreground">{config[kind].help}</p></header>
<form id="document-form" class="space-y-5">
<section class="rounded-2xl border border-border bg-card p-5"><h2 class="font-semibold">1. Referencias</h2><div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
<label class="space-y-1.5 text-xs font-semibold">Cliente<select required name="customer_id" class={input}><option value="">Seleccionar cliente…</option>{customers.map(c=><option value={c.id}>{c.social_reason}</option>)}</select></label>
{kind!=="receipts"&&<label class="space-y-1.5 text-xs font-semibold">Pedido de venta<select required name="sale_order_id" class={input}><option value="">Seleccionar pedido…</option>{orders.map(o=><option value={o.id} data-customer={o.customer_id} data-items={JSON.stringify(o.items)} data-currency={o.currency}>{o.id.slice(0,8)} · {o.status}</option>)}</select></label>}
{kind!=="invoices"&&<label class="space-y-1.5 text-xs font-semibold">Factura asociada<select name={kind==="remittances"?"sales_invoice_id":"invoice_choice"} class={input}><option value="">Seleccionar factura…</option>{invoices.map(i=><option value={i.id} selected={selectedInvoice===i.id} data-customer={i.customer_id} data-currency={i.currency} data-balance={balances[i.id]} data-items={JSON.stringify(i.items)}>{i.point_of_sale}-{i.document_number} · saldo {i.currency} {balances[i.id]}</option>)}</select></label>}
</div></section>
<section class="rounded-2xl border border-border bg-card p-5"><h2 class="font-semibold">2. Datos del documento</h2><div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
{kind!=="receipts"&&<><label class="space-y-1.5 text-xs font-semibold">Punto de venta<input name="point_of_sale" type="number" min="1" value="1" required class={input}/></label><label class="space-y-1.5 text-xs font-semibold">Número<input name="document_number" inputmode="numeric" required class={input}/></label><label class="space-y-1.5 text-xs font-semibold">Emisión<input name="issue_date" type="date" value={today} required class={input}/></label></>}
{kind==="invoices"&&<><label class="space-y-1.5 text-xs font-semibold">Vencimiento<input name="due_date" type="date" value={today} required class={input}/></label><label class="space-y-1.5 text-xs font-semibold">Tipo<select name="document_type" class={input}><option value="INVOICE">Factura</option><option value="CREDIT">Nota de crédito</option><option value="DEBIT">Nota de débito</option></select></label></>}
{kind==="remittances"&&<label class="space-y-1.5 text-xs font-semibold">Fecha de entrega<input name="delivery_date" type="date" value={today} required class={input}/></label>}
{kind==="receipts"&&<><label class="space-y-1.5 text-xs font-semibold">Número de recibo<input name="receipt_number" inputmode="numeric" required class={input}/></label><label class="space-y-1.5 text-xs font-semibold">Fecha<input name="receipt_date" type="date" value={today} required class={input}/></label><label class="space-y-1.5 text-xs font-semibold">Medio de pago<select name="payment_method" class={input}><option value="TRANSFER">Transferencia</option><option value="CASH">Efectivo</option><option value="CHECK">Cheque</option><option value="CARD">Tarjeta</option></select></label><label class="space-y-1.5 text-xs font-semibold">Referencia<input name="payment_reference" class={input}/></label></>}
{kind!=="remittances"&&<><label class="space-y-1.5 text-xs font-semibold">Moneda<select name="currency" class={input}><option>ARS</option><option>USD</option><option>EUR</option><option>CAD</option></select></label><label id="exchange-wrap" class="space-y-1.5 text-xs font-semibold">Tipo de cambio<input name="exchange_rate" inputmode="decimal" value="1.00" required class={input}/></label></>}
</div></section>
{kind!=="receipts"?<section class="rounded-2xl border border-border bg-card p-5"><div class="flex items-center justify-between"><div><h2 class="font-semibold">3. Ítems</h2><p class="text-xs text-muted-foreground">{kind==="invoices"?"Los importes se calculan automáticamente.":"Podés ajustar cantidades para realizar una entrega parcial."}</p></div><button id="add-line" type="button" class="rounded-lg border border-border px-3 py-2 text-xs font-semibold">Agregar ítem</button></div><div class="mt-4 overflow-x-auto"><table class="w-full min-w-220 text-sm"><thead class="text-left text-xs text-muted-foreground"><tr><th class="p-2">Producto</th><th class="p-2">Descripción</th><th class="p-2">Cantidad</th>{kind==="invoices"&&<><th class="p-2">Precio unitario</th><th class="p-2">IVA %</th><th class="p-2 text-right">Total</th></>} {kind==="remittances"&&<th class="p-2">Lote</th>}<th></th></tr></thead><tbody id="lines"></tbody></table></div>{kind==="invoices"&&<div class="mt-5 ml-auto grid max-w-sm gap-2 rounded-xl bg-secondary/50 p-4 text-sm"><div class="flex justify-between"><span>Subtotal</span><strong id="subtotal">0.00</strong></div><div class="flex justify-between"><span>IVA</span><strong id="tax-total">0.00</strong></div><div class="flex justify-between border-t border-border pt-2 text-base"><span>Total</span><strong id="grand-total">0.00</strong></div></div>}</section>:
<section class="rounded-2xl border border-border bg-card p-5"><h2 class="font-semibold">3. Aplicación de la cobranza</h2><div class="mt-4 grid gap-4 sm:grid-cols-3"><label class="space-y-1.5 text-xs font-semibold">Saldo antes<input id="balance-before" readonly class={input}/></label><label class="space-y-1.5 text-xs font-semibold">Importe a aplicar<input name="amount" id="receipt-amount" inputmode="decimal" required class={input}/></label><label class="space-y-1.5 text-xs font-semibold">Saldo después<input id="balance-after" readonly class={input}/></label></div><p class="mt-3 text-xs text-muted-foreground">La cobranza puede ser parcial, pero nunca superar el saldo disponible.</p></section>}
<div id="feedback" class="hidden rounded-xl border border-destructive/30 bg-destructive/5 p-4 text-sm text-destructive"></div><div class="flex justify-end gap-3"><a href={`/admin/sales/${kind}`} class="rounded-lg border border-border px-4 py-2 text-sm font-semibold">Cancelar</a><button id="submit" class="rounded-lg bg-primary px-5 py-2 text-sm font-semibold text-primary-foreground">Guardar borrador</button></div></form></div>
<template id="line-template"><tr class="line border-t border-border"><td class="p-2"><select data-field="product_id" class={input}><option value="">Seleccionar…</option>{products.map(p=><option value={p.id} data-name={p.name}>{p.name}</option>)}</select></td><td class="p-2"><input data-field="description" class={input}/></td><td class="p-2"><input data-field="quantity" inputmode="decimal" value="1.00" class={input}/></td>{kind==="invoices"&&<><td class="p-2"><input data-field="unit_price" inputmode="decimal" value="0.00" class={input}/></td><td class="p-2"><input data-field="tax_rate" inputmode="decimal" value="21.00" class={input}/></td><td class="line-total p-2 text-right font-semibold">0.00</td></>}{kind==="remittances"&&<td class="p-2"><input data-field="lot_number" class={input}/></td>}<td class="p-2"><button type="button" class="remove-line text-xs font-semibold text-destructive">Quitar</button></td></tr></template>
</AppLayout>
<script define:vars={{kind}}>
const form=document.querySelector("#document-form"),lines=document.querySelector("#lines"),tpl=document.querySelector("#line-template"),feedback=document.querySelector("#feedback"),submit=document.querySelector("#submit");
const n=v=>Number(String(v||0).replace(",","."))||0, fixed=v=>v.toFixed(2);
function addLine(source={}){const row=tpl.content.firstElementChild.cloneNode(true);row.querySelectorAll("[data-field]").forEach(el=>{if(source[el.dataset.field]!==undefined)el.value=source[el.dataset.field]});const product=row.querySelector('[data-field="product_id"]');product.addEventListener("change",()=>{const description=row.querySelector('[data-field="description"]');if(!description.value)description.value=product.selectedOptions[0]?.dataset.name||""});row.querySelector(".remove-line").onclick=()=>{row.remove();recalc()};row.querySelectorAll("input,select").forEach(el=>el.addEventListener("input",recalc));lines.append(row);if(!row.querySelector('[data-field="description"]').value)row.querySelector('[data-field="description"]').value=product.selectedOptions[0]?.dataset.name||"";recalc()}
function recalc(){let sub=0,tax=0;document.querySelectorAll(".line").forEach(row=>{if(kind==="invoices"){const q=n(row.querySelector('[data-field="quantity"]').value),p=n(row.querySelector('[data-field="unit_price"]').value),r=n(row.querySelector('[data-field="tax_rate"]').value);const net=q*p,t=net*r/100;sub+=net;tax+=t;row.querySelector(".line-total").textContent=fixed(net+t)}});if(kind==="invoices"){document.querySelector("#subtotal").textContent=fixed(sub);document.querySelector("#tax-total").textContent=fixed(tax);document.querySelector("#grand-total").textContent=fixed(sub+tax)}}
document.querySelector("#add-line")?.addEventListener("click",()=>addLine());
const order=document.querySelector('[name="sale_order_id"]');order?.addEventListener("change",()=>{const o=order.selectedOptions[0];form.customer_id.value=o.dataset.customer||"";if(form.currency)form.currency.value=o.dataset.currency||"ARS";lines.innerHTML="";JSON.parse(o.dataset.items||"[]").forEach(x=>addLine({product_id:x.product_id,quantity:fixed(n(x.quantity)),unit_price:fixed(n(x.unit_price)),tax_rate:"21.00"}));});
const invoice=document.querySelector('[name="sales_invoice_id"],[name="invoice_choice"]');function invoiceChanged(){if(!invoice)return;const o=invoice.selectedOptions[0];form.customer_id.value=o.dataset.customer||"";if(form.currency)form.currency.value=o.dataset.currency||"ARS";if(kind==="remittances"){lines.innerHTML="";JSON.parse(o.dataset.items||"[]").forEach(x=>addLine({product_id:x.product_id,description:x.description,quantity:x.quantity,lot_number:""}))}if(kind==="receipts"){document.querySelector("#balance-before").value=o.dataset.balance||"0.00";document.querySelector("#receipt-amount").max=o.dataset.balance||"0";updateBalance()}}invoice?.addEventListener("change",invoiceChanged);
function updateBalance(){const before=n(document.querySelector("#balance-before")?.value),amount=n(document.querySelector("#receipt-amount")?.value);document.querySelector("#balance-after").value=fixed(before-amount)}document.querySelector("#receipt-amount")?.addEventListener("input",updateBalance);
document.querySelector('[name="currency"]')?.addEventListener("change",e=>document.querySelector("#exchange-wrap").classList.toggle("hidden",e.target.value==="ARS"));
if(kind!=="receipts")addLine();if(invoice?.value)invoiceChanged();
form.addEventListener("submit",async e=>{e.preventDefault();feedback.classList.add("hidden");submit.disabled=true;try{const data=Object.fromEntries(new FormData(form).entries());data.idempotency_key=crypto.randomUUID();if(data.point_of_sale)data.point_of_sale=Number(data.point_of_sale);delete data.invoice_choice;if(kind==="invoices"||kind==="remittances"){data.items=Array.from(document.querySelectorAll(".line")).map((row,index)=>{const item={line_number:index+1};row.querySelectorAll("[data-field]").forEach(el=>item[el.dataset.field]=el.value);if(kind==="invoices"){const net=n(item.quantity)*n(item.unit_price),tax=net*n(item.tax_rate)/100;item.net_amount=fixed(net);item.tax_amount=fixed(tax);item.total_amount=fixed(net+tax)}return item});if(kind==="invoices"){data.subtotal=document.querySelector("#subtotal").textContent;data.tax_total=document.querySelector("#tax-total").textContent;data.total_amount=document.querySelector("#grand-total").textContent}}else{const selected=invoice.selectedOptions[0],amount=fixed(n(data.amount));if(n(amount)>n(selected.dataset.balance))throw new Error("El importe supera el saldo disponible.");data.allocations=[{sales_invoice_id:invoice.value,allocated_amount:amount}]}const res=await fetch(`/api/admin/sales/${kind}`,{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify(data)}),body=await res.json().catch(()=>({}));if(!res.ok)throw new Error(body.error||`Error ${res.status}`);location.href=`/admin/sales/${kind}/${body.id}`}catch(err){feedback.textContent=err.message;feedback.classList.remove("hidden");submit.disabled=false}});
</script>
