---
import AppLayout from "@/layouts/AppLayout.astro";
import AdminNav from "@/components/admin/AdminNav.astro";
import StatusBadge from "@/components/admin/StatusBadge.astro";
import { COOKIE_NAME } from "@/lib/auth";
import { getCustomerByID } from "@/lib/grpc/customerClient";
import { getSalesDocument, getSalesInvoiceOutstandingBalance } from "@/lib/grpc/salesAdministrationClient";
import type { SalesDocumentKind } from "@/lib/grpc/salesAdministrationTypes";
const config={invoices:{title:"Factura de venta",action:"issue",actionLabel:"Emitir factura",final:"ISSUED",collection:"items"},remittances:{title:"Remito",action:"confirm",actionLabel:"Confirmar remito",final:"CONFIRMED",collection:"items"},receipts:{title:"Cobranza",action:"post",actionLabel:"Contabilizar cobranza",final:"POSTED",collection:"allocations"}} as const;
const kind=Astro.params.kind as SalesDocumentKind;if(!config[kind])return Astro.redirect("/admin");
const token=Astro.cookies.get(COOKIE_NAME)?.value,id=Astro.params.id!;let document:any=null,balance="",customerName="",error="";
try{document=await getSalesDocument(kind,id,token);customerName=(await getCustomerByID(document.customer_id,token).catch(()=>null))?.social_reason??"";if(kind==="invoices")balance=(await getSalesInvoiceOutstandingBalance(id,token)).outstanding_balance}catch(e:any){error=e.message}
const c=config[kind],money=(v:any,currency="ARS")=>new Intl.NumberFormat("es-AR",{style:"currency",currency:currency||"ARS",maximumFractionDigits:2}).format(Number(v||0));
const fields=kind==="invoices"?[["Cliente",customerName],["Pedido",document?.sale_order_id],["Emisión",document?.issue_date],["Vencimiento",document?.due_date],["Moneda",document?.currency],["Subtotal",money(document?.subtotal,document?.currency)],["IVA",money(document?.tax_total,document?.currency)],["Total",money(document?.total_amount,document?.currency)]]:kind==="remittances"?[["Cliente",customerName],["Pedido",document?.sale_order_id],["Factura asociada",document?.sales_invoice_id],["Emisión",document?.issue_date],["Entrega",document?.delivery_date]]:[["Cliente",customerName],["Fecha",document?.receipt_date],["Moneda",document?.currency],["Importe",money(document?.amount,document?.currency)],["Medio de pago",document?.payment_method],["Referencia",document?.payment_reference]];
---
<AppLayout title={c.title}><AdminNav/><div class="mx-auto max-w-5xl space-y-6 px-4 py-7 sm:px-8">
<a href={`/admin/sales/${kind}`} class="text-xs font-semibold text-primary">← Volver al listado</a>
{error?<div class="rounded-xl border border-destructive/30 bg-destructive/5 p-4 text-sm text-destructive">{error}</div>:document&&<>
<header class="flex flex-col justify-between gap-4 sm:flex-row sm:items-start"><div><div class="flex flex-wrap items-center gap-3"><h1 class="text-3xl font-display">{c.title} {document.document_number||document.receipt_number}</h1><StatusBadge status={document.status}/></div><p class="mt-1 text-sm text-muted-foreground">{customerName||"Cliente"} · Documento administrativo</p></div>{document.status!==c.final&&<button id="action-button" data-action={c.action} class="rounded-lg bg-primary px-4 py-2 text-sm font-semibold text-primary-foreground">{c.actionLabel}</button>}</header>
{kind==="remittances"&&document.status!=="CONFIRMED"&&<div class="rounded-xl border border-amber-700/20 bg-amber-700/8 p-4 text-sm"><strong>Importante:</strong> el stock se descuenta al confirmar este remito. La confirmación es definitiva.</div>}
{kind==="invoices"&&<section class="flex flex-col justify-between gap-4 rounded-2xl border border-primary/20 bg-primary/5 p-5 sm:flex-row sm:items-center"><div><p class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">Saldo pendiente de cobro</p><p class="mt-1 text-2xl font-semibold">{money(balance,document.currency)}</p></div>{Number(balance)>0&&<a href={`/admin/sales/receipts/new?invoice=${document.id}`} class="rounded-lg bg-primary px-4 py-2 text-sm font-semibold text-primary-foreground">Registrar cobranza</a>}</section>}
<section class="rounded-2xl border border-border bg-card p-5"><h2 class="font-semibold">Información del documento</h2><dl class="mt-5 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">{fields.map(([label,value])=><div><dt class="text-[10px] font-semibold uppercase tracking-wider text-muted-foreground">{label}</dt><dd class="mt-1 break-all text-sm">{String(value||"—")}</dd></div>)}</dl></section>
<section class="overflow-hidden rounded-2xl border border-border bg-card"><div class="border-b border-border px-5 py-4"><h2 class="font-semibold">{kind==="receipts"?"Facturas alcanzadas":"Ítems del documento"}</h2></div><div class="overflow-x-auto"><table class="w-full min-w-160 text-sm"><thead class="bg-muted/30 text-left text-xs text-muted-foreground"><tr>{kind==="receipts"?<><th class="p-4">Factura</th><th class="p-4 text-right">Importe aplicado</th></>:<><th class="p-4">Descripción</th><th class="p-4">Producto</th><th class="p-4 text-right">Cantidad</th>{kind==="invoices"&&<><th class="p-4 text-right">Precio</th><th class="p-4 text-right">IVA</th><th class="p-4 text-right">Total</th></>}</>}</tr></thead><tbody class="divide-y divide-border">{(document[c.collection]??[]).map((row:any)=>kind==="receipts"?<tr><td class="p-4">{row.sales_invoice_id}</td><td class="p-4 text-right font-semibold">{money(row.allocated_amount,document.currency)}</td></tr>:<tr><td class="p-4">{row.description||"—"}</td><td class="p-4 text-xs text-muted-foreground">{row.product_id}</td><td class="p-4 text-right">{row.quantity}</td>{kind==="invoices"&&<><td class="p-4 text-right">{money(row.unit_price,document.currency)}</td><td class="p-4 text-right">{row.tax_rate}%</td><td class="p-4 text-right font-semibold">{money(row.total_amount,document.currency)}</td></>}</tr>)}</tbody></table></div></section>
</>}</div><div id="toast" class="hidden fixed bottom-6 right-6 rounded-xl border border-destructive/30 bg-card p-4 text-sm text-destructive shadow-lg"></div></AppLayout>
<script>document.getElementById("action-button")?.addEventListener("click",async event=>{const button=event.currentTarget as HTMLButtonElement;const parts=location.pathname.split("/").filter(Boolean),kind=parts[2],id=parts[3];const warning=kind==="remittances"?"Al confirmar el remito se descontará stock. ¿Querés continuar?":kind==="invoices"?"Al emitir la factura quedará cerrada para edición. ¿Querés continuar?":"Al contabilizar la cobranza se aplicará a las facturas seleccionadas. ¿Querés continuar?";if(!confirm(warning))return;button.disabled=true;const response=await fetch(`/api/admin/sales/${kind}/${id}/${button.dataset.action}`,{method:"POST"});if(response.ok)location.reload();else{const body=await response.json().catch(()=>({})),toast=document.getElementById("toast")!;toast.textContent=body.error??`Error ${response.status}`;toast.classList.remove("hidden");button.disabled=false}});</script>
