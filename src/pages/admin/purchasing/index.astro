---
import AppLayout from "@/layouts/AppLayout.astro";
import AdminNav from "@/components/admin/AdminNav.astro";
import StatusBadge from "@/components/admin/StatusBadge.astro";
import AdminTable from "@/components/admin/AdminTable.astro";
import { COOKIE_NAME } from "@/lib/auth";
import { listPurchaseNeeds,listSupplierInvoices,listSupplierPayments,listSupplierQuotes,listSuppliers } from "@/lib/grpc/purchasingAdministrationClient";
const token=Astro.cookies.get(COOKIE_NAME)?.value;let suppliers:any[]=[],needs:any[]=[],quotes:any[]=[],invoices:any[]=[],payments:any[]=[],errors:string[]=[];
await Promise.all([listSuppliers(true,token).then(v=>suppliers=v).catch(e=>errors.push(e.message)),listPurchaseNeeds(token).then(v=>needs=v).catch(e=>errors.push(e.message)),listSupplierQuotes("",token).then(v=>quotes=v).catch(e=>errors.push(e.message)),listSupplierInvoices("",token).then(v=>invoices=v).catch(e=>errors.push(e.message)),listSupplierPayments("",token).then(v=>payments=v).catch(e=>errors.push(e.message))]);
const section=Astro.url.searchParams.get("section")??"needs",showNew=Astro.url.searchParams.get("new")==="1",supplierName=Object.fromEntries(suppliers.map(s=>[s.id,s.trade_name||s.social_reason]));
const tabs=[["needs","Necesidades"],["quotes","Cotizaciones"],["invoices","Facturas de proveedor"],["suppliers","Proveedores"],["payments","Pagos"]];
const input="w-full rounded-lg border border-input bg-background px-3 py-2.5 text-sm",money=(v:any,c="ARS")=>new Intl.NumberFormat("es-AR",{style:"currency",currency:c,maximumFractionDigits:2}).format(Number(v||0)),today=new Date().toISOString().slice(0,10);
---
<AppLayout title="Compras y proveedores"><AdminNav/><div class="mx-auto max-w-350 space-y-6 px-4 py-7 sm:px-8">
<header class="flex flex-col justify-between gap-4 sm:flex-row sm:items-end"><div><p class="text-xs font-semibold uppercase tracking-[.2em] text-primary">Circuito de compras</p><h1 class="mt-2 text-3xl font-display">Compras y proveedores</h1><p class="mt-1 text-sm text-muted-foreground">Necesidades, cotizaciones, comprobantes y pagos organizados por etapa.</p></div><a href={`/admin/purchasing?section=${section}&new=1`} class="rounded-lg bg-primary px-4 py-2 text-center text-sm font-semibold text-primary-foreground">Nuevo registro</a></header>
{errors.length>0&&<div class="rounded-xl border border-destructive/30 bg-destructive/5 p-4 text-sm text-destructive">Algunos datos no pudieron cargarse: {errors.join(" · ")}</div>}
<nav class="flex gap-2 overflow-x-auto">{tabs.map(([id,label])=><a href={`/admin/purchasing?section=${id}`} class:list={["shrink-0 rounded-full px-3.5 py-2 text-xs font-semibold",section===id?"bg-primary text-primary-foreground":"border border-border bg-card"]}>{label}</a>)}</nav>
<div id="feedback" class="hidden sticky top-16 z-20 rounded-xl border p-3 text-sm shadow-lg"></div>

{section==="suppliers"&&<section class="space-y-4"><div><h2 class="text-xl font-semibold">Proveedores</h2><p class="text-xs text-muted-foreground">Datos de contacto y estado de cada proveedor.</p></div>{showNew&&<form class="rpc-form grid gap-3 rounded-2xl border border-border bg-card p-5 md:grid-cols-3" data-endpoint="/api/admin/purchasing/suppliers"><input name="tax_id" class={input} placeholder="CUIT" required/><input name="social_reason" class={input} placeholder="Razón social" required/><input name="trade_name" class={input} placeholder="Nombre comercial"/><input name="email" type="email" class={input} placeholder="Email"/><input name="phone" class={input} placeholder="Teléfono"/><input name="address" class={input} placeholder="Dirección"/><button class="rounded-lg bg-primary px-4 py-2 text-sm font-semibold text-primary-foreground">Guardar proveedor</button></form>}<div class="overflow-x-auto rounded-2xl border border-border bg-card"><table class="w-full text-sm"><thead class="bg-muted/30 text-left text-xs text-muted-foreground"><tr><th class="p-4">Proveedor</th><th class="p-4">CUIT</th><th class="p-4">Contacto</th><th class="p-4">Estado</th><th class="p-4"></th></tr></thead><tbody class="divide-y divide-border">{suppliers.map(s=><tr><td class="p-4 font-semibold">{s.trade_name||s.social_reason}<span class="block text-xs font-normal text-muted-foreground">{s.social_reason}</span></td><td class="p-4">{s.tax_id}</td><td class="p-4">{s.email||s.phone||"—"}</td><td class="p-4"><StatusBadge status={s.active?"ACTIVE":"CANCELLED"}/></td><td class="p-4 text-right">{s.active&&<button class="rpc-action text-xs font-semibold text-destructive" data-endpoint={`/api/admin/purchasing/suppliers/${s.id}`} data-method="DELETE" data-confirm="¿Desactivar este proveedor?">Desactivar</button>}</td></tr>)}</tbody></table></div></section>}

{section==="needs"&&<section class="space-y-4"><div><h2 class="text-xl font-semibold">Necesidades de compra</h2><p class="text-xs text-muted-foreground">Registrá insumos requeridos y avanzá su estado.</p></div>{showNew&&<form class="rpc-form grid gap-3 rounded-2xl border border-border bg-card p-5 md:grid-cols-4" data-endpoint="/api/admin/purchasing/purchase-needs" data-kind="need"><input name="need_number" class={input} placeholder="Número" required/><input name="requested_date" type="date" value={today} class={input} required/><input name="required_by_date" type="date" value={today} class={input} required/><input name="notes" class={input} placeholder="Notas"/><input name="line_description" class={input} placeholder="Insumo o descripción" required/><input name="line_dry_supply_id" class={input} placeholder="Código del insumo" required/><input name="line_quantity" inputmode="decimal" class={input} placeholder="Cantidad requerida" required/><select name="line_unit" class={input}><option value="UNIT">Unidades</option><option value="KG">Kilogramos</option><option value="L">Litros</option></select><button class="rounded-lg bg-primary px-4 py-2 text-sm font-semibold text-primary-foreground">Guardar necesidad</button></form>}<div class="grid gap-3 lg:grid-cols-2">{needs.map(n=><article class="rounded-2xl border border-border bg-card p-5"><div class="flex justify-between gap-3"><div><h3 class="font-semibold">Necesidad #{n.need_number}</h3><p class="text-xs text-muted-foreground">Requerida para {n.required_by_date} · {n.items.length} ítems</p></div><StatusBadge status={n.status}/></div><div class="mt-4 flex flex-wrap gap-2">{["OPEN","APPROVED","CANCELLED"].map(status=><button class="rpc-action rounded-lg border border-border px-2.5 py-1.5 text-xs font-semibold" data-endpoint={`/api/admin/purchasing/purchase-needs/${n.id}`} data-method="PATCH" data-body={JSON.stringify({status})} data-confirm="¿Actualizar el estado de esta necesidad?">{status==="OPEN"?"Pendiente":status==="APPROVED"?"Aprobar":"Cancelar"}</button>)}</div></article>)}</div></section>}

{section==="quotes"&&<section class="space-y-4"><div><h2 class="text-xl font-semibold">Cotizaciones</h2><p class="text-xs text-muted-foreground">Compará ofertas antes de seleccionar proveedor.</p></div>{showNew&&<form class="rpc-form grid gap-3 rounded-2xl border border-border bg-card p-5 md:grid-cols-4" data-endpoint="/api/admin/purchasing/quotes" data-kind="line"><select name="supplier_id" class={input} required><option value="">Proveedor…</option>{suppliers.filter(s=>s.active).map(s=><option value={s.id}>{s.trade_name||s.social_reason}</option>)}</select><select name="purchase_need_id" class={input} required><option value="">Necesidad…</option>{needs.map(n=><option value={n.id}>#{n.need_number}</option>)}</select><input name="quote_number" class={input} placeholder="Número de cotización" required/><input name="quote_date" type="date" value={today} class={input} required/><input name="valid_until" type="date" value={today} class={input} required/><select name="currency" class={input}><option>ARS</option><option>USD</option></select><input name="exchange_rate" value="1.00" class={input} required/><input name="line_dry_supply_id" class={input} placeholder="Código de insumo" required/><input name="line_description" class={input} placeholder="Descripción" required/><input name="line_quantity" class={input} placeholder="Cantidad" required/><input name="line_unit_price" class={input} placeholder="Precio unitario" required/><input name="line_tax_rate" value="21.00" class={input} placeholder="IVA %" required/><button class="rounded-lg bg-primary px-4 py-2 text-sm font-semibold text-primary-foreground">Guardar cotización</button></form>}<AdminTable rows={quotes} type="quotes" supplierName={supplierName} money={money}/></section>}

{section==="invoices"&&<section class="space-y-4"><div><h2 class="text-xl font-semibold">Facturas de proveedor</h2><p class="text-xs text-muted-foreground">Comprobantes recibidos, vencimientos y pagos pendientes.</p></div>{showNew&&<form class="rpc-form grid gap-3 rounded-2xl border border-border bg-card p-5 md:grid-cols-4" data-endpoint="/api/admin/purchasing/invoices" data-kind="line"><select name="supplier_id" class={input} required><option value="">Proveedor…</option>{suppliers.map(s=><option value={s.id}>{s.trade_name||s.social_reason}</option>)}</select><select name="supplier_quote_id" class={input}><option value="">Sin cotización</option>{quotes.map(q=><option value={q.id}>{q.quote_number}</option>)}</select><select name="document_type" class={input}><option value="FACTURA_A">Factura A</option><option value="FACTURA_B">Factura B</option></select><input name="point_of_sale" type="number" value="1" class={input} required/><input name="document_number" class={input} placeholder="Número" required/><input name="issue_date" type="date" value={today} class={input} required/><input name="due_date" type="date" value={today} class={input} required/><select name="currency" class={input}><option>ARS</option><option>USD</option></select><input name="exchange_rate" value="1.00" class={input}/><input name="line_dry_supply_id" class={input} placeholder="Código de insumo" required/><input name="line_description" class={input} placeholder="Descripción" required/><input name="line_quantity" class={input} placeholder="Cantidad" required/><input name="line_unit_price" class={input} placeholder="Precio unitario" required/><input name="line_tax_rate" value="21.00" class={input} placeholder="IVA %" required/><button class="rounded-lg bg-primary px-4 py-2 text-sm font-semibold text-primary-foreground">Guardar factura</button></form>}<AdminTable rows={invoices} type="invoices" supplierName={supplierName} money={money}/></section>}

{section==="payments"&&<section class="space-y-4"><div><h2 class="text-xl font-semibold">Pagos a proveedores</h2><p class="text-xs text-muted-foreground">Aplicá pagos a comprobantes pendientes.</p></div>{showNew&&<form class="rpc-form grid gap-3 rounded-2xl border border-border bg-card p-5 md:grid-cols-4" data-endpoint="/api/admin/purchasing/payments" data-kind="payment"><select name="supplier_id" class={input} required><option value="">Proveedor…</option>{suppliers.map(s=><option value={s.id}>{s.trade_name||s.social_reason}</option>)}</select><select name="line_supplier_invoice_id" class={input} required><option value="">Factura a pagar…</option>{invoices.filter(i=>i.status==="ISSUED").map(i=><option value={i.id}>{supplierName[i.supplier_id]} · {i.document_number} · {i.currency} {i.total_amount}</option>)}</select><input name="payment_number" class={input} placeholder="Número de pago" required/><input name="payment_date" type="date" value={today} class={input} required/><select name="currency" class={input}><option>ARS</option><option>USD</option></select><input name="exchange_rate" value="1.00" class={input}/><input name="amount" class={input} placeholder="Importe a aplicar" required/><select name="payment_method" class={input}><option value="TRANSFER">Transferencia</option><option value="CASH">Efectivo</option><option value="CHECK">Cheque</option></select><input name="payment_reference" class={input} placeholder="Referencia"/><button class="rounded-lg bg-primary px-4 py-2 text-sm font-semibold text-primary-foreground">Guardar pago</button></form>}<AdminTable rows={payments} type="payments" supplierName={supplierName} money={money}/></section>}
</div></AppLayout>

<!-- Local table keeps each purchasing tab compact without changing routes. -->
{/** @ts-ignore */}
<script>const feedback=document.querySelector("#feedback");function show(message,ok){feedback.textContent=message;feedback.className=`sticky top-16 z-20 rounded-xl border p-3 text-sm shadow-lg ${ok?"border-green-300 bg-green-50 text-green-800":"border-destructive/30 bg-destructive/5 text-destructive"}`}async function rpc(endpoint,method,body){const r=await fetch(endpoint,{method,headers:{"Content-Type":"application/json"},body:body===undefined?undefined:JSON.stringify(body)}),data=await r.json().catch(()=>({}));if(!r.ok)throw new Error(data.error||`Error ${r.status}`);return data}document.querySelectorAll(".rpc-form").forEach(form=>form.addEventListener("submit",async e=>{e.preventDefault();const button=form.querySelector("button");button.disabled=true;try{const body=Object.fromEntries(new FormData(form).entries());body.idempotency_key=crypto.randomUUID();const kind=form.dataset.kind;if(kind==="need"){body.items=[{line_number:1,dry_supply_id:body.line_dry_supply_id,description:body.line_description,quantity:body.line_quantity,unit:body.line_unit}]}if(kind==="line"){const q=Number(body.line_quantity),p=Number(body.line_unit_price),rate=Number(body.line_tax_rate),net=q*p,tax=net*rate/100;body.subtotal=net.toFixed(2);body.tax_total=tax.toFixed(2);body.total_amount=(net+tax).toFixed(2);body.items=[{purchase_need_item_id:"",supplier_quote_item_id:"",line_number:1,dry_supply_id:body.line_dry_supply_id,description:body.line_description,quantity:String(body.line_quantity),unit:"UNIT",unit_price:String(body.line_unit_price),tax_rate:String(body.line_tax_rate),net_amount:body.subtotal,tax_amount:body.tax_total,total_amount:body.total_amount}]}if(kind==="payment")body.allocations=[{supplier_invoice_id:body.line_supplier_invoice_id,allocated_amount:String(body.amount)}];Object.keys(body).filter(k=>k.startsWith("line_")).forEach(k=>delete body[k]);if(body.point_of_sale)body.point_of_sale=Number(body.point_of_sale);await rpc(form.dataset.endpoint,"POST",body);show("Registro guardado. Actualizando…",true);setTimeout(()=>location.reload(),500)}catch(err){show(err.message,false);button.disabled=false}}));document.querySelectorAll(".rpc-action").forEach(button=>button.addEventListener("click",async()=>{if(button.dataset.confirm&&!confirm(button.dataset.confirm))return;button.disabled=true;try{await rpc(button.dataset.endpoint,button.dataset.method,button.dataset.body?JSON.parse(button.dataset.body):undefined);show("Operación realizada. Actualizando…",true);setTimeout(()=>location.reload(),500)}catch(err){show(err.message,false);button.disabled=false}}));</script>
