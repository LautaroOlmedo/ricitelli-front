---
import StatusBadge from "./StatusBadge.astro";
const { rows = [], type, supplierName = {}, money } = Astro.props;
const title=(r:any)=>type==="quotes"?r.quote_number:type==="invoices"?`${r.point_of_sale}-${r.document_number}`:`Pago #${r.payment_number}`;
const date=(r:any)=>type==="quotes"?r.quote_date:type==="invoices"?r.due_date:r.payment_date;
const total=(r:any)=>type==="payments"?r.amount:r.total_amount;
---
<div class="overflow-x-auto rounded-2xl border border-border bg-card"><table class="w-full min-w-180 text-sm"><thead class="bg-muted/30 text-left text-xs text-muted-foreground"><tr><th class="p-4">Documento</th><th class="p-4">Proveedor</th><th class="p-4">{type==="invoices"?"Vencimiento":"Fecha"}</th><th class="p-4">Estado</th><th class="p-4 text-right">Importe</th><th class="p-4"></th></tr></thead><tbody class="divide-y divide-border">{rows.map((r:any)=><tr><td class="p-4 font-semibold">{title(r)}</td><td class="p-4">{supplierName[r.supplier_id]||"—"}</td><td class="p-4">{date(r)||"—"}</td><td class="p-4"><StatusBadge status={r.status}/></td><td class="p-4 text-right font-semibold">{money(total(r),r.currency)}</td><td class="p-4 text-right">{type==="quotes"&&<button class="rpc-action text-xs font-semibold text-primary" data-endpoint={`/api/admin/purchasing/quotes/${r.id}`} data-method="PATCH" data-body='{"status":"SELECTED"}' data-confirm="¿Seleccionar esta cotización?">Seleccionar</button>}{type==="invoices"&&r.status==="DRAFT"&&<button class="rpc-action text-xs font-semibold text-primary" data-endpoint={`/api/admin/purchasing/invoices/${r.id}`} data-method="PATCH" data-body='{"action":"issue"}' data-confirm="¿Emitir esta factura de proveedor?">Emitir</button>}{type==="payments"&&r.status==="DRAFT"&&<button class="rpc-action text-xs font-semibold text-primary" data-endpoint={`/api/admin/purchasing/payments/${r.id}`} data-method="PATCH" data-body='{"action":"post"}' data-confirm="¿Contabilizar este pago?">Contabilizar</button>}</td></tr>)}</tbody></table></div>
